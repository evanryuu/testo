# Copy this file to .env and configure the model as in Midscene.
# Leave optional fields absent when your model service does not require them.
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_FAMILY=

# Midscene's MIDSCENE_PLANNING_MODEL_* and MIDSCENE_INSIGHT_MODEL_*
# variables are also passed through unchanged when configured.
