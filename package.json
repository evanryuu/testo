{
  "name": "testing-workspace-web-runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:runner": "tsc",
    "test:runner": "npm run build:runner && node --test --test-concurrency=1 dist/tests/runner.test.js",
    "run:workflow": "node dist/src/runner/cli.js",
    "typecheck:desktop": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.preview.json",
    "build:desktop": "tsc && tsc -p tsconfig.ui.json && vite build && npm run build:preview",
    "desktop": "electron .",
    "test:desktop": "node --test --test-concurrency=1 dist/tests/desktop.test.js",
    "test:recording": "node --test --test-concurrency=1 dist/tests/navigation.test.js dist/tests/viewport.test.js dist/tests/recording-retry.test.js dist/tests/recorded-workflow.test.js dist/tests/recording-events.test.js dist/tests/recording-description.test.js dist/tests/recording.test.js",
    "build:preview": "tsc -p tsconfig.preview.json && vite build --config vite.preview.config.ts",
    "test:chrome-bridge": "node --test --test-concurrency=1 dist/tests/chrome-bridge.test.js"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.0",
    "@midscene/playground": "1.12.4",
    "@midscene/shared": "1.12.4",
    "@midscene/test": "1.12.4",
    "@midscene/web": "1.12.4",
    "@playwright/test": "1.63.0",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.0",
    "antd": "5.21.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.42.0",
    "playwright": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "zod": "3.25.76",
    "@midscene/core": "1.12.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.2.0",
    "esbuild": "0.28.2",
    "less": "4.2.0",
    "node-stdlib-browser": "1.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "main": "dist/src/main/index.js"
}
