{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["react", "react-dom", "node", "vite/client"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@midscene/visualizer": ["./vendor/midscene-preview/visualizer/index.ts"]
    }
  },
  "include": ["src/official-preview/**/*", "vendor/midscene-preview/**/*"]
}
