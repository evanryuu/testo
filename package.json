{
  "name": "testing-workspace-web-runner",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:runner": "tsc",
    "test:runner": "npm run build:runner && node --test --test-concurrency=1 dist/tests/runner.test.js",
    "run:workflow": "node dist/src/runner/cli.js",
    "typecheck:desktop": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.preview.json",
    "build:desktop": "tsc && tsc -p tsconfig.ui.json && vite build && npm run build:preview && npm run build:connector",
    "desktop": "electron .",
    "test:desktop": "node --test --test-concurrency=1 dist/tests/desktop.test.js",
    "test:recording": "node --test --test-concurrency=1 dist/tests/navigation.test.js dist/tests/viewport.test.js dist/tests/wait.test.js dist/tests/wait-integration.test.js dist/tests/recording-retry.test.js dist/tests/recorded-workflow.test.js dist/tests/recording-events.test.js dist/tests/recording-description.test.js dist/tests/recording.test.js",
    "build:preview": "tsc -p tsconfig.preview.json && vite build --config vite.preview.config.ts",
    "test:chrome-bridge": "node --test --test-concurrency=1 dist/tests/chrome-bridge.test.js",
    "build:connector": "node scripts/build-browser-extension.mjs",
    "package:dir": "npm run build:desktop && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "package:mac": "npm run build:desktop && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "package:connector": "npm run build:connector && node scripts/package-connector.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.5.0",
    "@midscene/core": "1.12.4",
    "@midscene/playground": "1.12.4",
    "@midscene/shared": "1.12.4",
    "@midscene/test": "1.12.4",
    "@midscene/web": "1.12.4",
    "@playwright/test": "1.63.0",
    "@xyflow/react": "12.11.6",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.0",
    "antd": "5.21.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.9",
    "express": "4.22.2",
    "fflate": "0.8.3",
    "lucide-react": "1.42.0",
    "overlayscrollbars": "2.16.0",
    "playwright": "1.63.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "4.17.25",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "less": "4.2.0",
    "node-stdlib-browser": "1.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "0.28.0"
  },
  "main": "dist/src/main/index.js",
  "description": "基于 Midscene 的本地自动化测试工作台",
  "author": "Testo contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/evanryuu/testo.git"
  }
}
